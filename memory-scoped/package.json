{
  "name": "dsh-scoped-memory",
  "version": "0.1.0",
  "description": "On-demand scoped memory recall with BM25-style ranking, time decay and evidence-backed notes for DSH",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./ranking": "./lib/memory-rank.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/check-syntax.mjs && node tests/ranking.mjs",
    "test:integration": "node tests/memory.mjs && node tests/friend.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
